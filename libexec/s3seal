#!/usr/bin/env bash
#
# s3seal: turn sealing on or off for a client, move its credentials between
# plaintext and encrypted storage, and show the state.
#
#   s3seal enable  aws|mc [--yes | --no-migrate]
#   s3seal disable aws|mc [--yes | --no-migrate]
#   s3seal migrate aws|mc [--to plain]
#   s3seal status
#   s3seal upgrade [--check] [--force]
#
# "credential-process" is called by the AWS CLI, not by users.
set -euo pipefail

VERSION="1.1.0"

_self="$0"
while [[ -L "$_self" ]]; do
  _t="$(readlink "$_self")"
  [[ "$_t" == /* ]] && _self="$_t" || _self="$(dirname "$_self")/$_t"
done
S3SEAL_HOME="$(cd "$(dirname "$_self")/.." && pwd)"

# shellcheck source=lib/common.sh
. "$S3SEAL_HOME/lib/common.sh"
# shellcheck source=lib/ini.sh
. "$S3SEAL_HOME/lib/ini.sh"
# shellcheck source=lib/aws.sh
. "$S3SEAL_HOME/lib/aws.sh"
# shellcheck source=lib/mc.sh
. "$S3SEAL_HOME/lib/mc.sh"

BIN_DIR="${S3SEAL_INSTALL_DIR:-$S3SEAL_HOME/bin}"
CLIENTS="aws mc"

bin_path() { printf '%s/%s' "$BIN_DIR" "$1"; }

linked() { [[ -L "$(bin_path "$1")" && "$(readlink "$(bin_path "$1")")" == "$S3SEAL_HOME/libexec/$1" ]]; }

# Link the command NAME in the bin folder to its entry point. A plain copy left
# by an older install is replaced; anything else that is there is refused.
link_entry() {
  local target; target="$(bin_path "$1")"
  linked "$1" && return 0
  if [[ -L "$target" ]]; then
    die "$target is a link to something else; move it aside first"
  elif [[ -e "$target" ]]; then
    grep -q '^# s3seal:' "$target" || die "$target exists and is not s3seal; move it aside first"
    rm -f "$target"
  fi
  mkdir -p "$BIN_DIR"
  ln -s "$S3SEAL_HOME/libexec/$1" "$target"
}

unlink_entry() {
  if linked "$1"; then rm -f "$(bin_path "$1")"; fi
}

supported() {
  case "$1" in
    aws|mc) ;;
    *) die "unknown client '$1'; supported clients: $CLIENTS" ;;
  esac
}

# Makes sure the client exists, and remembers where it is.
preflight() {
  case "$1" in
    aws)
      find_real aws >/dev/null || die "the AWS CLI is not installed or not on PATH" ;;
    mc)
      need_mc ;;
  esac
}

need_mc() {
  MC_REAL="$(mc_real_binary)" || die "the MinIO client (mc) is not installed or not found. Set MC_BIN."
  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "$MC_REAL" > "$CONFIG_DIR/mc-path"
}

# Names of credentials still in plaintext, one per line.
plain_names() {
  case "$1" in
    aws) aws_plaintext_profiles ;;
    mc) need_mc; mc_plaintext_aliases | while IFS= read -r l; do json_field "$l" alias; echo; done ;;
  esac
}

# Names of credentials in the encrypted store, one per line.
sealed_names() {
  case "$1" in
    aws) aws_sealed_profiles ;;
    mc) mc_sealed_aliases ;;
  esac
}

to_sealed() {
  case "$1" in
    aws) aws_enable ;;
    mc) need_mc; mc_seal_all ;;
  esac
}

to_plain() {
  case "$1" in
    aws) aws_disable ;;
    mc) mc_unseal_all ;;
  esac
}

# Steps the user can do by hand when they decline the automatic migration.
manual_sealed() {
  case "$1" in
    aws)
      printf '  aws configure --profile NAME   re-enter the keys; they are stored encrypted\n' ;;
    mc)
      printf '  mc alias set NAME URL          asks for the keys; stored encrypted\n'
      printf '  %s alias remove NAME   removes the plaintext copy\n' "$MC_REAL" ;;
  esac
}

# Asks before moving credentials. --yes migrates, --no-migrate skips, and with
# no terminal nothing is moved.
confirm_migrate() {  # QUESTION FLAG
  case "$2" in
    --yes) return 0 ;;
    --no-migrate) return 1 ;;
  esac
  have_tty || { warn "no terminal to ask; not migrating (pass --yes to migrate now)"; return 1; }
  local answer=''
  prompt_tty answer "$1? [y/N]: "
  [[ "$answer" == y || "$answer" == Y || "$answer" == yes ]]
}

count_lines() { grep -c . || true; }

# Reads names on stdin, prints them on one line separated by ", ".
join_commas() { { grep . || true; } | paste -sd, - | sed "s/,/, /g"; }

cmd_enable() {  # TOOL [FLAG]
  local tool="$1" flag="${2-}" count
  supported "$tool"
  preflight "$tool"
  link_entry "$tool"
  count="$(plain_names "$tool" | count_lines)"
  if (( count == 0 )); then
    printf 'No plaintext %s credentials to migrate.\n' "$tool"
  elif confirm_migrate "Migrate $count $tool credential(s) to encrypted storage now" "$flag"; then
    to_sealed "$tool"
  else
    printf 'Left %s credential(s) in plaintext. To migrate them later, run:\n  s3seal migrate %s\n' "$count" "$tool"
    printf 'Or do it by hand:\n'
    manual_sealed "$tool"
  fi
  if [[ "$(command -v "$tool" 2>/dev/null || true)" != "$(bin_path "$tool")" ]]; then
    warn "'$tool' does not resolve to the s3seal link yet: put $BIN_DIR before the other $tool on PATH"
  fi
  printf '%s is sealed.\n' "$tool"
}

cmd_disable() {  # TOOL [FLAG]
  local tool="$1" flag="${2-}" count
  supported "$tool"
  count="$(sealed_names "$tool" | count_lines)"
  if (( count > 0 )); then
    preflight "$tool"
    if confirm_migrate "Restore $count $tool credential(s) to plaintext now" "$flag"; then
      to_plain "$tool"
    else
      printf 'Left %s credential(s) sealed. To restore them later, run:\n  s3seal migrate %s --to plain\n' "$count" "$tool"
    fi
  fi
  unlink_entry "$tool"
  printf '%s is no longer sealed.\n' "$tool"
}

cmd_migrate() {  # TOOL [--to plain|sealed]
  local tool="$1" to=sealed count
  shift
  supported "$tool"
  while (( $# )); do
    case "$1" in
      --to) to="${2-}"; shift 2 ;;
      *) die "unknown option '$1' for migrate" ;;
    esac
  done
  preflight "$tool"
  if [[ "$to" == sealed ]]; then
    count="$(plain_names "$tool" | count_lines)"
    if (( count == 0 )); then printf 'Nothing to migrate for %s.\n' "$tool"; return 0; fi
    to_sealed "$tool"
  elif [[ "$to" == plain ]]; then
    count="$(sealed_names "$tool" | count_lines)"
    if (( count == 0 )); then printf 'Nothing to migrate for %s.\n' "$tool"; return 0; fi
    to_plain "$tool"
  else
    die "--to takes 'plain' or 'sealed'"
  fi
}

cmd_status() {
  local tool names
  for tool in $CLIENTS; do
    printf '%s:\n' "$tool"
    if linked "$tool"; then printf '  enabled:    yes\n'; else printf '  enabled:    no\n'; fi
    names="$(sealed_names "$tool" | join_commas)"
    [[ -n "$names" ]] && printf '  sealed:     %s\n' "$names"
    names="$(plain_names "$tool" 2>/dev/null | join_commas)"
    [[ -n "$names" ]] && printf '  PLAINTEXT:  %s (run: s3seal migrate %s)\n' "$names" "$tool"
  done
}

usage() {
  cat <<EOF
usage:
  s3seal enable  aws|mc [--yes | --no-migrate]
  s3seal disable aws|mc [--yes | --no-migrate]
  s3seal migrate aws|mc [--to plain]
  s3seal status
  s3seal upgrade [--check] [--force]
  s3seal --version
EOF
}

cmd_upgrade() {
  local check=0 force=0 repo=mhbahmani/s3seal ref=master latest tmp a
  for a in "$@"; do
    case "$a" in
      --check) check=1 ;;
      --force) force=1 ;;
      *) die "unknown option '$a' for upgrade" ;;
    esac
  done
  [[ -f "$S3SEAL_HOME/source" ]] \
    || die "upgrade works on an installed copy, not on a git checkout (no $S3SEAL_HOME/source)"
  read -r repo ref < "$S3SEAL_HOME/source" || true
  command -v curl >/dev/null 2>&1 || die "curl is required to upgrade"

  tmp="$(mktemp -d)"
  # Expanded now: a local variable is gone by the time the EXIT trap runs.
  # shellcheck disable=SC2064  # expanded now on purpose: the local is gone at exit
  trap "rm -rf '$tmp'" EXIT
  curl -fsSL "https://raw.githubusercontent.com/$repo/$ref/libexec/s3seal" -o "$tmp/s3seal" \
    || die "cannot fetch $repo@$ref"
  latest="$(sed -n 's/^VERSION="\(.*\)"$/\1/p' "$tmp/s3seal" | head -n1)"

  if (( check )); then
    printf 'installed %s, available %s (%s@%s)\n' "$VERSION" "$latest" "$repo" "$ref"
    exit 0
  fi
  if [[ "$latest" == "$VERSION" ]] && (( ! force )); then
    printf 's3seal %s is already the latest version. Nothing to do.\n' "$VERSION"
    exit 0
  fi

  # install.sh checks every file it installs against its own checksum table,
  # so the upgrade is verified the same way as a fresh install.
  curl -fsSL "https://raw.githubusercontent.com/$repo/$ref/install.sh" -o "$tmp/install.sh" \
    || die "cannot fetch the installer from $repo@$ref"
  S3SEAL_UPGRADE=1 S3SEAL_REPO="$repo" S3SEAL_REF="$ref" S3SEAL_SHARE_DIR="$S3SEAL_HOME" \
    S3SEAL_INSTALL_DIR="$BIN_DIR" S3SEAL_CONFIG_DIR="$CONFIG_DIR" bash "$tmp/install.sh"
}

case "${1-}" in
  enable)
    [[ -n "${2-}" ]] || die "usage: s3seal enable aws|mc [--yes | --no-migrate]"
    cmd_enable "$2" "${3-}" ;;
  disable)
    [[ -n "${2-}" ]] || die "usage: s3seal disable aws|mc [--yes | --no-migrate]"
    cmd_disable "$2" "${3-}" ;;
  migrate)
    [[ -n "${2-}" ]] || die "usage: s3seal migrate aws|mc [--to plain]"
    shift; cmd_migrate "$@" ;;
  status) cmd_status ;;
  upgrade) shift; cmd_upgrade "$@" ;;
  credential-process)
    [[ "${2-}" == aws ]] || die "unknown credential source '${2-}'"
    aws_credential_process "${3-}" ;;
  -h|--help|help) usage ;;
  --version|version) printf 's3seal %s\n' "$VERSION" ;;
  "") usage; exit 1 ;;
  *) die "unknown command '$1'; see s3seal --help" ;;
esac
